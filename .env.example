# Copy to .env and fill in real values. .env is gitignored and must never be committed.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# On Render, DEBUG is False so login is required. Override here if needed.
# DJANGO_REQUIRE_LOGIN=True

# --- Database ---
# Local dev defaults to SQLite when unset. On Render, set this to the Postgres
# connection string provided by the managed database.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Shopify ---
# Store domain, without protocol.
SHOPIFY_STORE=your-store.myshopify.com
# Optional: a static Admin API token (shpat_...) from a store custom app.
# If empty, the app exchanges SHOPIFY_CLIENT_ID + SHOPIFY_CLIENT_SECRET for a
# 24-hour token via the client-credentials grant.
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2025-01

# --- Inkthreadable ---
INKTHREADABLE_APP_ID=
INKTHREADABLE_SECRET_KEY=
INKTHREADABLE_BASE_URL=https://www.inkthreadable.co.uk/api
# How the GET signing payload is built: query | path | url
INKTHREADABLE_AUTH_STYLE=query

# First login is created on deploy (username laura). Override the first
# password here if you do not want the default. Existing passwords are never reset.
# OPERATOR_PASSWORD=
